{
  "expo": {
    "name": "DermaScan",
    "slug": "Frontend",
    "icon": "./assets/logo/dermascan-logo.png",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#00CC99",
        "foregroundImage": "./assets/logo/dermascan-logo.png"
      },
      "package": "com.dermascan.app"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo/dermascan-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#00CC99"
        }
      ],
      "expo-router",
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "icon": "./assets/notif/notif.png",
          "color": "#00CC99"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "407c5758-380e-439c-8b7c-c74e00d0a601"
      }
    }
  }
}
